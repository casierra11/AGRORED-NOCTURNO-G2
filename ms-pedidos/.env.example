# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio (ms-pedidos usa el 3004).
PORT=3004
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo
HOST=127.0.0.1

# --- Configuración de la Base de Datos (MySQL) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pedidos_db
DB_PORT=3306

# Clave con la que se firman y verifican los tokens JWT (DEBE SER IDÉNTICA a ms-usuarios)
JWT_SECRET=mi_clave_secreta
